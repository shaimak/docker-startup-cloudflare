# Example environment for Hermes Agent.
# Copy to .env_files/hermes.env and fill in. Never commit the real file.

# Host user that owns data/hermes (id -u / id -g), so container-written
# files stay owned by you.
HERMES_UID=1000
HERMES_GID=1000

# --- AI Provider Keys (OpenAI-compatible endpoints) ---
# Referenced by data/hermes/data/config.yaml via ${VAR} substitution.
# Free tiers: Groq (https://console.groq.com), Gemini (https://aistudio.google.com).
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Dashboard Basic Auth (single user; no sign-up) ---
# Required: the dashboard binds 0.0.0.0 for the reverse proxy and fails closed
# without an auth provider. Set a username and EITHER a plaintext password OR a
# precomputed hash (hash preferred — no plaintext at rest).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin

# Option A — plaintext (simplest). Hashed in-memory at startup.
#HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me

# Option B — precomputed scrypt hash (preferred). See README.md for the command.
# GOTCHA: docker compose interpolates $ in env-file values and scrypt hashes use
# $ as separators, so EVERY $ must be doubled ($$) here. The container receives
# the correct single-$ hash. If PASSWORD (option A) is also set non-empty, it
# WINS over the hash.
#HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=scrypt$$16384$$8$$1$$<salt>$$<dk>

# Signs session cookies. Set an explicit value or sessions drop on every
# restart. Generate: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
