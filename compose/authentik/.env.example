# Example Environment Variables for Authentik

# --- Core Settings ---
# Generate a strong, unique secret key:  openssl rand -hex 32
AUTHENTIK_SECRET_KEY=
# Set the external URL Authentik will be accessed at (CRITICAL for redirects)
AUTHENTIK_URL=https://mysso.mydomain.com
# Set the Email address authentik will use to send emails (password recovery, etc.)
AUTHENTIK_EMAIL= # e.g., authentik@mydomain.com or your admin email

# --- Database Credentials ---
# Database user (default: authentik)
PG_USER=authentik
# Database name (default: authentik)
PG_DB=authentik
# Generate a strong, unique password for the database:  openssl rand -hex 24
PG_PASS=

# --- Optional: skip the interactive first-run setup page ---
# Set these BEFORE the very first `up -d` and Authentik seeds the `akadmin`
# account for you, so you can log in straight away instead of going to
# /if/flow/initial-setup/. Read only on the first boot against an empty
# database — setting or changing them later does nothing.
# Blank both lines once you have logged in; leaving a plaintext admin password
# in the env file is the sort of thing that gets forgotten.
# AUTHENTIK_BOOTSTRAP_PASSWORD=
# AUTHENTIK_BOOTSTRAP_EMAIL=

# --- Ports (Optional: only if you want direct access besides reverse proxy) ---
# AUTHENTIK_PORT_HTTP=9000
# AUTHENTIK_PORT_HTTPS=9443

# --- Image Tag (Optional: the compose file pins a known-good version) ---
# Upgrade one minor train at a time (e.g. 2026.2 -> 2026.5, never skipping) and
# never downgrade — migrations are one-way.
# AUTHENTIK_TAG=2026.5.6

# --- Optional: Authentik specific settings ---
# See Authentik documentation for many more options:
# https://goauthentik.io/docs/installation/configuration
# Example: Adjust log level
# AUTHENTIK_LOG_LEVEL=info
