# compose/cloudflared/.env.example
# Copy to ../../.env_files/cloudflared.env and fill in the real token.
#
# The token comes from the Cloudflare Zero Trust dashboard when you create the
# tunnel: Networks -> Tunnels -> your tunnel -> Install connector. Copy the long
# string that follows `--token` in the Docker command shown there.
CLOUDFLARE_TUNNEL_TOKEN=eyJ...replace-me...
