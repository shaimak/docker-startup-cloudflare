# compose/vaultwarden/.env.example
# Copy to .env_files/vaultwarden.env and fill in your own values.
# Never commit the real file — it holds your admin token.

# Public URL Caddy serves this on. Must be exact, including https://.
# Vaultwarden builds attachment links, WebAuthn origins and the notifications
# websocket URL from this — a wrong value breaks 2FA and file downloads.
DOMAIN=https://mypass.mydomain.com

# Lock the instance down: nobody can self-register a new vault.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false

# /admin panel. Generate with: openssl rand -base64 48
# Optionally store an Argon2 hash instead of plaintext:
#   docker run --rm -it vaultwarden/server:1.37.1-alpine /vaultwarden hash
ADMIN_TOKEN=replace_me

# Caddy sets X-Forwarded-For but not X-Real-IP (Vaultwarden's default), so
# without this every client looks like the Docker gateway in logs and rate limits.
IP_HEADER=X-Forwarded-For

# Bitwarden's push relay needs credentials from bitwarden.com/host — off by default.
PUSH_ENABLED=false

# Keep the worker pool small if the host runs many containers.
ROCKET_WORKERS=2
LOG_LEVEL=warn
